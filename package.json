{
  "name": "esports-hub",
  "version": "0.5.0",
  "private": true,
  "description": "Esports Hub — портал CS2, Dota 2 и LoL: матчи, команды, игроки, турниры (данные BO3.GG), собственные статьи и гайды",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "migrate": "node src/database/migrate.js",
    "sync": "node src/services/run-sync-once.js",
    "admin:create": "node src/admin/create-admin.js",
    "test": "node --test tests/*.test.js",
    "update-data": "node scripts/update-data.js",
    "build:static": "npm i --no-save esbuild sql.js@1.10.3 && node scripts/build-static.js",
    "prerender": "node scripts/prerender.js",
    "seo:check": "node scripts/seo-check.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "compression": "^1.8.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "node-cron": "^3.0.3"
  }
}
